# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/service-core ./packages/service-core
COPY services/loyalty-service ./services/loyalty-service
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter @retail/loyalty-service build

FROM gcr.io/distroless/nodejs22-debian12:nonroot
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/services/loyalty-service/dist ./dist
COPY --from=build /app/services/loyalty-service/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/service-core/dist ./node_modules/@retail/service-core/dist
COPY --from=build /app/packages/service-core/package.json ./node_modules/@retail/service-core/package.json
USER nonroot
EXPOSE 8080
CMD ["dist/index.js"]
